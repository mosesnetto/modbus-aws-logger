# Copy this file to .env and fill in local values.
# Never commit .env, private keys, certificates, or logs.

AWS_IOT_ENDPOINT=your-endpoint.iot.region.amazonaws.com
AWS_IOT_PORT=8883
AWS_IOT_TOPIC=plc/data
AWS_IOT_CLIENT_ID=modbus-aws-logger

# Keep certificates outside this repository.
AWS_IOT_CA_FILE=C:/secure/aws-iot/AmazonRootCA1.pem
AWS_IOT_CLIENT_CERT_FILE=C:/secure/aws-iot/certificate.pem.crt
AWS_IOT_PRIVATE_KEY_FILE=C:/secure/aws-iot/private.pem.key

PLC_IP=192.168.1.3
PLC_PORT=502
PLC_UNIT_ID=1
PLC_REGISTER_COUNT=124
MACHINE_NAME=Machine_1

PUBLISH_INTERVAL_SECONDS=1
RECONNECT_DELAY_SECONDS=5
LOG_FILE=./iot_gateway.log
LOG_LEVEL=INFO

# Optional SMTP daily summary. Use a Gmail/Outlook app password, not a normal password.
# STARTTLS is required whenever SMTP is enabled.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
SMTP_TO=operations@example.com
SMTP_SUBJECT_PREFIX=Modbus AWS Logger
SMTP_USE_STARTTLS=true
SMTP_CHECK_INTERVAL_SECONDS=600
RUNTIME_DIR=./runtime
